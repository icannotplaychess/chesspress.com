generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth.js models ─────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?
  name          String?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts            Account[]
  sessions            Session[]
  profile             UserProfile?
  repertoires         Repertoire[]
  games               Game[]
  connectedAccounts   ConnectedChessAccount[]
  scoutJobs           ScoutAnalysisJob[]
  passwordResetTokens PasswordResetToken[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── User profile & settings ─────────────────────────────────────────────────

model UserProfile {
  id                 String  @id @default(cuid())
  userId             String  @unique
  displayName        String?
  coachPersonality   String  @default("balanced") // serious | balanced | chaotic
  explanationLength  String  @default("medium")   // short | medium | long
  humorLevel         String  @default("medium")
  beginnerMode       Boolean @default(false)
  boardTheme         String  @default("default")
  pieceTheme         String  @default("default")
  emailNotifications Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Connected external chess accounts ───────────────────────────────────────

model ConnectedChessAccount {
  id           String    @id @default(cuid())
  userId       String
  platform     String    // chesscom | lichess
  username     String
  accessToken  String?
  refreshToken String?
  tokenExpires DateTime?
  ratings      String?   // JSON: { bullet, blitz, rapid, classical }
  connectedAt  DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform])
}

// ─── Repertoires (server-side, per user) ─────────────────────────────────────

model Repertoire {
  id        String   @id @default(cuid())
  userId    String
  name      String
  color     String   @default("white")
  lines     String   // JSON: RepertoireLine[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Saved / imported games ──────────────────────────────────────────────────

model Game {
  id          String   @id @default(cuid())
  userId      String?
  platform    String?  // chesscom | lichess | import
  externalId  String?
  pgn         String
  white       String?
  black       String?
  result      String?  // 1-0 | 0-1 | 1/2-1/2
  timeControl String?
  openingEco  String?
  openingName String?
  playedAt    DateTime?
  analysis    String?  // JSON: cached analysis summary
  createdAt   DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([platform, externalId])
}

// ─── Player Scout ────────────────────────────────────────────────────────────

model ScoutAnalysisJob {
  id         String   @id @default(cuid())
  userId     String?
  platform   String   // chesscom | lichess
  username   String
  status     String   @default("pending") // pending | fetching | analyzing | complete | failed
  progress   Int      @default(0)
  totalGames Int      @default(0)
  message    String?
  resultId   String?
  error      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user   User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  result ScoutAnalysisResult? @relation(fields: [resultId], references: [id])

  @@index([userId])
  @@index([platform, username])
}

model ScoutAnalysisResult {
  id         String   @id @default(cuid())
  platform   String
  username   String
  report     String   // JSON: full ScoutReport
  gameCount  Int
  cachedAt   DateTime @default(now())
  expiresAt  DateTime

  jobs ScoutAnalysisJob[]

  @@unique([platform, username])
  @@index([platform, username])
}
