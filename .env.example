# Database (SQLite for local dev; use PostgreSQL in production)
DATABASE_URL="file:./prisma/dev.db"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=your_auth_secret_here
NEXTAUTH_URL=http://localhost:3000

# Google OAuth (optional — enables "Continue with Google")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email for password reset (optional — logs link in dev without this)
RESEND_API_KEY=
EMAIL_FROM=ChessPress <noreply@chesspress.com>

# Lichess Personal API Token (server-side opening explorer proxy)
LICHESS_API_TOKEN=lip_your_token_here
