# ─── Vercel Postgres (production) ───────────────────────────────────────────
# Linking Vercel Postgres auto-injects POSTGRES_PRISMA_URL — vercel-build uses
# that when DATABASE_URL is unset. For local dev, copy from Storage → .env.local:
DATABASE_URL="postgresql://..."
# Optional direct URL for migrations (POSTGRES_URL_NON_POOLING on Vercel)
DIRECT_URL="postgresql://..."

# ─── Auth (required) ─────────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
AUTH_SECRET=your_auth_secret_here
NEXTAUTH_URL=http://localhost:3000

# ─── Google OAuth (optional) ─────────────────────────────────────────────────
# https://console.cloud.google.com → Credentials → OAuth client ID
# Redirect URI: https://YOUR-DOMAIN/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Email password reset (optional) ─────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=ChessPress <noreply@yourdomain.com>

# ─── Lichess opening explorer (recommended) ────────────────────────────────────
# https://lichess.org/account/oauth/token
LICHESS_API_TOKEN=lip_your_token_here
