# ─── Vercel Postgres (production) ───────────────────────────────────────────
# In Vercel → Storage → Postgres → .env.local tab, copy:
#   POSTGRES_PRISMA_URL  →  DATABASE_URL   (pooled — used by the app)
#   POSTGRES_URL_NON_POOLING  →  DIRECT_URL  (direct — used for migrations)
DATABASE_URL="postgresql://..."
DIRECT_URL="postgresql://..."

# Local dev: use the same strings from Vercel, or a free Neon database.

# ─── Auth (required) ─────────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
AUTH_SECRET=your_auth_secret_here
NEXTAUTH_URL=http://localhost:3000

# ─── Google OAuth (optional) ─────────────────────────────────────────────────
# https://console.cloud.google.com → Credentials → OAuth client ID
# Redirect URI: https://YOUR-DOMAIN/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Email password reset (optional) ─────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=ChessPress <noreply@yourdomain.com>

# ─── Lichess opening explorer (recommended) ────────────────────────────────────
# https://lichess.org/account/oauth/token
LICHESS_API_TOKEN=lip_your_token_here
