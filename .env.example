# ─── Vercel Postgres (production) ───────────────────────────────────────────
# In Vercel: Storage → Postgres → Connect to project (auto-injects POSTGRES_*).
# The app falls back to POSTGRES_PRISMA_URL at runtime — DATABASE_URL is optional.
# For local dev, copy POSTGRES_PRISMA_URL from Storage → .env.local as DATABASE_URL:
DATABASE_URL="postgresql://..."

# ─── Auth (required on Vercel) ───────────────────────────────────────────────
# Generate: openssl rand -base64 32
AUTH_SECRET=your_auth_secret_here
# Production: https://chesspress-com.vercel.app (or your custom domain)
NEXTAUTH_URL=http://localhost:3000

# ─── Google OAuth (optional) ─────────────────────────────────────────────────
# https://console.cloud.google.com → Credentials → OAuth client ID
# Redirect URI: https://YOUR-DOMAIN/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Email password reset (optional) ─────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=ChessPress <noreply@yourdomain.com>

# ─── Lichess opening explorer (recommended) ────────────────────────────────────
# https://lichess.org/account/oauth/token
LICHESS_API_TOKEN=lip_your_token_here
